0%;-0.0%" name="[Calculation_nkiedkss1afl]" role="measure" type="quantitative"><calculation class='tableau' formula="MAX(IF [period_date] = [Calculation_2214psgo71zg] THEN [Calculation_idict2dkcoqs] END) / MAX(IF [period_date] = DATEADD('month', -1, [Calculation_2214psgo71zg]) THEN [Calculation_idict2dkcoqs] END) - 1" /></column><column caption="KPI YoY" datatype="real" default-format="*+0.0%;-0.0%" name="[Calculation_jhboc61bag8k]" role="measure" type="quantitative"><calculation class='tableau' formula="[Calculation_lkpwbihjibzs] / [Calculation_0syhzggummfy] - 1" /></column><column caption="KPI % of Peak" datatype="real" default-format="p0%" name="[Calculation_ududwnr5336n]" role="measure" type="quantitative"><calculation class='tableau' formula="[Calculation_lkpwbihjibzs] / MAX(IF [period_date] &lt;= [Calculation_2214psgo71zg] THEN [Calculation_4x7s4axwxvgt] END)" /></column><column caption="Peak Label" datatype="string" name="[Calculation_ephv7xx5wxyq]" role="measure" type="nominal"><calculation class='tableau' formula='IF [Calculation_ududwnr5336n] &gt;= 0.9999 THEN "new peak" ELSE "of the highest month up to then" END' /></column><column caption="Provisional Label" datatype="string" name="[Calculation_kaseslk9guyr]" role="measure" type="nominal"><calculation class='tableau' formula='IF MAX(IF [period_date] = [Calculation_2214psgo71zg] AND [is_provisional] THEN 1 END) = 1 THEN " · PROVISIONAL" END' /></column><column caption="Ref Label" datatype="string" name="[Calculation_mvjys44cnjc8]" role="measure" type="nominal"><calculation class='tableau' formula="UPPER(DATENAME('month', MAX([Calculation_2214psgo71zg]))) + &quot; &quot; + STR(YEAR(MAX([Calculation_2214psgo71zg])))" /></column><column caption="Place Label" datatype="string" name="[Calculation_2ulhupkyprtk]" role="dimension" type="nominal"><calculation class='tableau' formula='(IF [Parameters].[Parameter 5] = "All states" THEN "BRAZIL" ELSE [Parameters].[Parameter 5] END)' /></column><column caption="Change