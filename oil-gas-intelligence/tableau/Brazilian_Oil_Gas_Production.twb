x="90000" y="1512" type-v2='dashboard-object'><button action='tabdoc:goto-sheet window-id=&quot;{197D2EAC-D8FF-5D07-927F-3D90C66A02C5}&quot;' button-type='text'><button-visual-state><caption>Method</caption><button-caption-font-style fontcolor="#0B302B" fontname='Arial' fontsize='8' /><format attr='background-color' value="#B8C9C0" /></button-visual-state></button></zone><zone h="2592" id="10" w="4750" x="2000" y="7775" type-v2='text'><formatted-text><run bold="false" fontcolor="#B8C9C0" fontname="Consolas" fontsize="8">PRODUCT</run></formatted-text><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="4" /></zone-style></zone><zone h="3024" id="11" w="10833" x="6750" y="7559" mode='compact' param="[Parameters].[Parameter 1]" show-title='false' type-v2='paramctrl'><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="2" /></zone-style></zone><zone h="2592" id="12" w="5333" x="19083" y="7775" type-v2='text'><formatted-text><run bold="false" fontcolor="#B8C9C0" fontname="Consolas" fontsize="8">OIL UNIT</run></formatted-text><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="4" /></zone-style></zone><zone h="3024" id="13" w="6667" x="24417" y="7559" mode='compact' param="[Parameters].[Parameter 2]" show-title='false' type-v2='paramctrl'><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="2" /></zone-style></zone><zone h="2592" id="14" w="4167" x="32583" y="7775" type-v2='text'><formatted-text><run bold="false" fontcolor="#B8C9C0" fontname="Consolas" fontsize="8">WINDOW</run></formatted-text><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="4" /></zone-style></zone><zone h="3024" id="15" w="10833" x="36750" y="7559" mode='compact' param="[Parameters].[Parameter 3]" show-title='false' type-v2='paramctrl'><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="2" /></zone-style></zone><zone h="2592" id="16" w="3000" x="49083" y="7775" type-v2='text'><formatted-text><run bold="false" fontcolor="#B8C9C0" fontname="Consolas" fontsize="8">YEAR</run></formatted-text><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="4" /></zone-style></zone><zone h="3024" id="17" w="6667" x="52083" y="7559" mode='compact' param="[Parameters].[Parameter 4]" show-title='false' type-v2='paramctrl'><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="2" /></zone-style></zone><zone h="2592" id="18" w="3583" x="60250" y="7775" type-v2='text'><formatted-text><run bold="false" fontcolor="#B8C9C0" fontname="Consolas" fontsize="8">STATE</run></formatted-text><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="4" /></zone-style></zone><zone h="3024" id="19" w="9167" x="63833" y="7559" mode='compact' param="[Parameters].[Parameter 5]" show-title='false' type-v2='paramctrl'><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="2" /></zone-style></zone><zone h="35637" id="20" w="96000" x="2000" y="12743" name="D1 Sources"><zone-style><format attr='background-color' value="#FFFFFF" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="4" /></zone-style></zone><zone h="12959" id="21" w="47500" x="2000" y="50324" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">UNITS</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">Oil and NGL in m³ (daily m³/d; bbl/d = m³/d × 6.28981); natural gas in thousand m³ (thousand m³/d). Oil and gas are never summed.</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="12959" id="22" w="47500" x="50500" y="50324" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">DEFINITIONS</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">K2 daily average = Σ volume / Σ days (recomputed at any grain) · K4 YoY on the same month · K14 share of national · K15 HHI by state · K17–K20 gas reinjection, flaring, own-use and available rates (Σ/Σ).</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="12959" id="23" w="47500" x="2000" y="64579" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">CLEANING RULES</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">R1 one row per level × place × product × month · R2 'not reported' kept as nulls · R3 days-in-month weighting · R4 provisional flag for 2026 · R5 national = Σ states, reconciled with the ANP yearbook (≤ 0.04 %).</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="12959" id="24" w="47500" x="50500" y="64579" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">LIMITATIONS</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">2026 data are provisional · UF gas-use rates are allocation-sensitive · no field-level data · no forecast · anomalies are statistical, not verified incidents.</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="12959" id="25" w="47500" x="2000" y="78834" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">HOW TO USE</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">The boxes in the band filter every page. Clicking a year (annual bars, gas balance, flaring), a state (map, ranking) or a product (growth regimes, seasonality, anomaly log) sets them; pick All states in the box to reset. The state filter applies to the regional and gas pages; production KPIs and stability views are national.</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="12959" id="26" w="47500" x="50500" y="78834" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">UPDATE</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">From oil-gas-intelligence/src: ..\..\.venv\Scripts\python.exe -m oilgas.pipeline, then refresh the extracts.</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="3024" id="27" w="96000" x="2000" y="96328" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Arial" fontsize="8">Source: ANP — production by state and location, snapshot 2026-11-18 · last month Sep 2026 (provisional) · oil and gas are never summed · click a year, state or product to filter · Stephany Alves</run></formatted-text><zone-style><format attr='margin' value="4" /></zone-style></zone></zones><simple-id uuid="{9AB26B4D-08F0-5A9F-8C5C-702E54AEDB80}" /></dashboard></dashboards><windows source-height='31'><window class='worksheet' hidden='true' name="P1 KPI Latest daily avg"><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid="{5784B4FB-A34C-558E-A075-59D635F82871}" /></window><window class='worksheet' hidden='true' name="P2 KPI MoM"><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid="{00BB36A2-218B-54AA-98E9-9BEBC607515F}" /></window><window class='worksheet' hidden='true' name="P3 KPI YoY"><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge></cards><simple-id uuid="{92589E90-A350-5F39-AA90-EDAFF1571A9F}" /></window><window class='worksheet' hidden='true' name="P4 KPI % of peak"><cards><edge name='left'><strip size='160'><card type='pages' /><card type='filters' /><card type='marks' /></strip></edge><edge name='top'><strip size='2147483647'><card type='columns' /></strip><strip size='2147483647'><card type='rows' /></strip><strip size='31'><card type='title' /></strip></edge><