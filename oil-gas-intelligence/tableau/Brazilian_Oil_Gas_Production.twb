" name="[share_of_national]" role="measure" type="quantitative" /><column datatype="real" default-format="n#,##0" name="[historical_peak_daily_avg]" role="measure" type="quantitative" /><column datatype="real" default-format="p0.0%" name="[pct_of_historical_peak]" role="measure" type="quantitative" /><column datatype="boolean" name="[is_new_peak]" role="dimension" type="nominal" /><column datatype="real" name="[volatility_12m]" role="measure" type="quantitative" /><column datatype="real" default-format="n#,##0" name="[baseline_12m_prior_daily_avg]" role="measure" type="quantitative" /><column datatype="real" default-format="p0.0%" name="[deviation_from_baseline_pct]" role="measure" type="quantitative" /><column datatype="real" name="[zscore_vs_prior_12m]" role="measure" type="quantitative" /><column datatype="boolean" name="[is_statistical_anomaly]" role="dimension" type="nominal" /><column caption="Is Product" datatype="boolean" name="[Calculation_8b57a0mf22k0]" role="dimension" type="nominal"><calculation class='tableau' formula="[product] = [Parameters].[Parameter 1]" /></column><column caption="Daily Avg" datatype="real" default-format="n#,##0" name="[Calculation_qqxnafln9eut]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([volume]) / SUM([days_in_month])" /></column><column caption="Daily Avg Display" datatype="real" default-format="n#,##0" name="[Calculation_6lch07lzb4hj]" role="measure" type="quantitative"><calculation class='tableau' formula='IF [Parameters].[Parameter 1] = "Oil" AND [Parameters].[Parameter 2] = "bbl/d" THEN [Calculation_qqxnafln9eut] * 6.28981 ELSE [Calculation_qqxnafln9eut] END' /></column><column caption="Display Unit" datatype="string" name="[Calculation_zsbp516rml33]" role="dimension" type="nominal"><calculation class='tableau' formula='IF [Parameters].[Parameter 1] = "Oil" AND [Parameters].[Parameter 2] = "bbl/d" THEN "bbl/d" ELSEIF [Parameters].[Parameter 1] = "Natural gas" THEN "thousand m³/d" ELSE "m³/d" END' /></column><column caption="Latest Month" datatype="date" name="[Calculation_ahm7ofhb3xgy]" role="dimension" type="ordinal"><calculation class='tableau' formula="{ FIXED : MAX([period_date]) }" /></column><column caption="Is Latest" datatype="boolean" name="[Calculation_ay2n59rvu28z]" role="dimension" type="nominal"><calculation class='tableau' formula="[period_date] = [Calculation_ahm7ofhb3xgy]" /></column><column caption="In Window" datatype="boolean" name="[Calculation_4iphp4uy6q5x]" role="dimension" type="nominal"><calculation class='tableau' formula="CASE [Parameters].[Parameter 3] WHEN &quot;Since 2000&quot; THEN [period_date] &gt;= #2000-01-01# WHEN &quot;Last 10 years&quot; THEN [period_date] &gt; DATEADD('year', -10, [Calculation_ahm7ofhb3xgy]) WHEN &quot;Last 36 months&quot; THEN [period_date] &gt; DATEADD('month', -36, [Calculation_ahm7ofhb3xgy]) END" /></column><column caption="Is Selected Year" datatype="boolean" name="[Calculation_v81pc3rob4e5]" role="dimension" type="nominal"><calculation class='tableau' formula="[year] = [Parameters].[Parameter 4]" /></column><column caption="KPI Latest Daily" datatype="real" default-format="n#,##0" name="[Calculation_5dravljds2zz]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM(IF [Calculation_ay2n59rvu28z] THEN [volume] END) / SUM(IF [Calculation_ay2n59rvu28z] THEN [days_in_month] END)" /></column><column caption="KPI Latest Daily Display" datatype="real" default-format="n#,##0" name="[Calculation_mxchwbzgb0hd]" role="measure" type="quantitative"><calculation class='tableau' formula='IF [Parameters].[Parameter 1] = "Oil" AND [Parameters].[Parameter 2] = "bbl/d" THEN [Calculation_5dravljds2zz] * 6.28981 ELSE [Calculation_5dravljds2zz] END' /></column><column caption="KPI Daily MoM" datatype="real" default-format="*+0.0%;-0.0%" name="[Calculation_i8766yu134lj]" role="measure" type="quantitative"><calculation class='tableau' formula="MAX(IF [Calculation_ay2n59rvu28z] THEN [daily_avg_mom] END)" /></column><column caption="KPI Volume MoM" datatype="real" default-format="*+0.0%;-0.0%" name="[Calculation_hn305wp66kfn]" role="measure" type="quantitative"><calculation class='tableau' formula="MAX(IF [Calculation_ay2n59rvu28z] THEN [mom] END)" /></column><column caption="KPI YoY" datatype="real" default-format="*+0.0%;-0.0%" name="[Calculation_ih0xsa2tbn84]" role="measure" type="quantitative"><calculation class='tableau' formula="MAX(IF [Calculation_ay2n59rvu28z] THEN [yoy] END)" /></column><column caption="KPI % of Peak" datatype="real" default-format="p0%" name="[Calculation_0gy2zfgodjde]" role="measure" type="quantitative"><calculation class='tableau' formula="MAX(IF [Calculation_ay2n59rvu28z] THEN [pct_of_historical_peak] END)" /></column><column caption="Peak Label" datatype="string" name="[Calculation_o6o2j3ykc94e]" role="measure" type="nominal"><calculation class='tableau' formula='IF MAX(IF [Calculation_ay2n59rvu28z] AND [is_new_peak] THEN 1 END) = 1 THEN "new peak" ELSE "of historical peak" END' /></column><column caption="Provisional Label" datatype="string" name="[Calculation_qaqgn6j5jteq]" role="measure" type="nominal"><calculation class='tableau' formula='IF MAX(IF [Calculation_ay2n59rvu28z] AND [is_provisional] THEN 1 END) = 1 THEN "PROVISIONAL" END' /></column><column caption="Latest Month Label" datatype="string" name="[Calculation_3kd94kvi79iu]" role="measure" type="nominal"><calculation class='tableau' formula="UPPER(DATENAME('month', MAX([Calculation_ahm7ofhb3xgy]))) + &quot; &quot; + STR(YEAR(MAX([Calculation_ahm7ofhb3xgy])))" /></column><column caption="Change Arrow" datatype="string" name="[Calculation_e37q2a2c0hmf]" role="measure" type="nominal"><calculation class='tableau' formula='IF [Calculation_i8766yu134lj] &gt;= 0 THEN "▲ " ELSE "▼ " END' /></column><column caption="YoY Arrow" datatype="string" name="[Calculation_rx9ocw7q81li]" role="measure" type="nominal"><calculation class='tableau' formula='IF [Calculation_ih0xsa2tbn84] &gt;= 0 THEN "▲ " ELSE "▼ " END' /></column><column caption="Rolling 12M Display" datatype="real" default-format="n#,##0" name="[Calculation_nf4uo5h1mg91]" role="measure" type="quantitative"><calculation class='tableau' formula='IF [Parameters].[Parameter 1] = "Oil" AND [Parameters].[Parameter 2] = "bbl/d" THEN AVG([rolling_12m_daily_avg]) * 6.28981 ELSE AVG([rolling_12m_daily_avg]) END' /></column><column caption="Baseline Band Low" datatype="real" default-format="n#,##0" name="[Calculation_nk7k7p2t3w40]" role="measure" type="quantitative"><calculation class='tableau' formula="AVG([baseline_12m_prior_daily_avg]) * 0.95" /></column><column caption="Baseline Band High" datatype="real" default-format="n#,##0" name="[Calculation_8n7zq6zf9f53]" role="measure" type="quantitative"><calculation class='tableau' formula="AVG([baseline_12m_prior_daily_avg]) * 1.05" /></column><column caption="Anomaly Marker" datatype="real" default-format="n#,##0" name="[Calculation_y8dmcph4f6kn]" role="measure" type="quantitative"><calculation class='tableau' formula="IF MAX(INT([is_statistical_anomaly])) = 1 THEN [Calculation_qqxnafln9eut] END" /></column><column caption="Last 36 Months" datatype="boolean" name="[Calculation_2lammoy2e1pu]" role="dimension" type="nominal"><calculation class='tableau' formula="[period_date] &gt; DATEADD('month', -36, [Calculation_ahm7ofhb3xgy])" /></column><extract count='-1' enabled='true' units='records'><connection access_mode='readonly' class='hyper' dbname="C:/Users/steph/AppData/Local/Temp/claude/2969279fcb9c72d1/bcca2772-7244-432c-82bb-04d37b4c745f/scratchpad/hyper_oil/prod_national.hyper" default-settings='hyper' schema='Extract' sslmode='' tablename='Extract' username='tableau_internal_user'><relation name='Extract' table='[Extract].[Extract]' type='table' /></connection></extract><style><style-rule element='mark'><encoding attr='color' field="[:Measure Names]" type='palette'><map to="#1e5246"><bucket>"[federated.w56j32w1fja49wpbjad2yxslxu50].[u