pe="quantitative"><calculation class='tableau' formula='IF [Parameters].[Parameter 1] = "Oil" AND [Parameters].[Parameter 2] = "bbl/d" THEN [Calculation_yc4scbf1uu3q] * 6.28981 ELSE [Calculation_yc4scbf1uu3q] END' /></column><column caption="Display Unit" datatype="string" name="[Calculation_rk3kvog7rdzc]" role="dimension" type="nominal"><calculation class='tableau' formula='IF [Parameters].[Parameter 1] = "Oil" AND [Parameters].[Parameter 2] = "bbl/d" THEN "bbl/d" ELSEIF [Parameters].[Parameter 1] = "Natural gas" THEN "thousand m³/d" ELSE "m³/d" END' /></column><column caption="Latest Month" datatype="date" name="[Calculation_w30xp99jki8u]" role="dimension" type="ordinal"><calculation class='tableau' formula="{ FIXED : MAX([period_date]) }" /></column><column caption="Is Latest" datatype="boolean" name="[Calculation_eg7lhkjvk524]" role="dimension" type="nominal"><calculation class='tableau' formula="[period_date] = [Calculation_w30xp99jki8u]" /></column><column caption="In Window" datatype="boolean" name="[Calculation_vhkxnjtge8ah]" role="dimension" type="nominal"><calculation class='tableau' formula="CASE [Parameters].[Parameter 3] WHEN &quot;Since 2000&quot; THEN [period_date] &gt;= #2000-01-01# WHEN &quot;Last 10 years&quot; THEN [period_date] &gt; DATEADD('year', -10, [Calculation_w30xp99jki8u]) WHEN &quot;Last 36 months&quot; THEN [period_date] &gt; DATEADD('month', -36, [Calculation_w30xp99jki8u]) END" /></column><column caption="Is Selected Year" datatype="boolean" name="[Calculation_99n9jewtr6su]" role="dimension" type="nominal"><calculation class='tableau' formula="[year] = [Parameters].[Parameter 4]" /></column><column caption="Share (recomputed)" datatype="real" default-format="p0.0%" name="[Calculation_3ivhrza4lrsb]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([volume]) / MIN({FIXED [product], [year] : SUM([volume])})" /></column><column caption="State Focus" datatype="string" name="[Calculation_pnvkyw3kp61l]" role="dimension" type="nominal"><calculation class='tableau' formula='CASE [product] WHEN "Oil" THEN (CASE [uf] WHEN "RJ" THEN [uf_name] WHEN "ES" THEN [uf_name] WHEN "SP" THEN [uf_name] WHEN "RN" THEN [uf_name] ELSE "Other states" END) WHEN "Natural gas" THEN (CASE [uf] WHEN "RJ" THEN [uf_name] WHEN "AM" THEN [uf_name] WHEN "SP" THEN [uf_name] WHEN "ES" THEN [uf_name] ELSE "Other states" END) WHEN "NGL (LGN)" THEN (CASE [uf] WHEN "SP" THEN [uf_name] WHEN "RJ" THEN [uf_name] WHEN "AM" THEN [uf_name] WHEN "ES" THEN [uf_name] ELSE "Other states" END) END' /></column><column caption="State Filter" datatype="boolean" name="[Calculation_eazdafec1idi]" role="dimension" type="nominal"><calculation class='tableau' formula='[Parameters].[Parameter 5] = "All states" OR [uf] = [Parameters].[Parameter 5]' /></column><column caption="Days" datatype="real" default-format="n#,##0" name="[Calculation_gmkq6pvc7h9j]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([days_in_month]) / COUNTD([uf])" /></column><column caption="In Selection" datatype="boolean" name="[Calculation_f27arb6wlz1p]" role="dimension" type="nominal"><calculation class='tableau' formula='[product] = [Parameters].[Parameter 1] AND ([Parameters].[Parameter 5] = "All states" OR [uf] = [Parameters].[Parameter 5])' /></column><column caption="Ref Month" datatype="date" name="[Calculation_2214psgo71zg]" role="dimension" type="ordinal"><calculation class='tableau' formula="IF YEAR([Calculation_w30xp99jki8u]) &lt;= [Parameters].[Parameter 4] THEN [Calculation_w30xp99jki8u] ELSE MAKEDATE([Parameters].[Parameter 4], 12, 1) END" /></column><column caption="Month Volume" datatype="real" default-format="n#,##0" name="[Calculation_idict2dkcoqs]" role="measure" type="quantitative"><calculation class='tableau' formula='{FIXED [period_date] : SUM(IF [product] = [Parameters].[Parameter 1] AND ([Parameters].[Parameter 5] = "All states" OR [uf] = [Parameters].[Parameter 5]) THEN [volume] END)}' /></column><column 