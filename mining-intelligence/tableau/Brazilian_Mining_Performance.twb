    <worksheet name='E5 Annual evolution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#101714' fontname='Arial' fontsize='11'>Annual evolution · R$ bn (nominal) · click a year</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='amb_uf_substance_year' name='federated.5g0p6rp0tvg32924ec5grivo9548' />
            <datasource caption='Parâmetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p Year' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
            <column caption='p Substance' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All substances&quot;'>
              <calculation class='tableau' formula='&quot;All substances&quot;' />
            </column>
            <column caption='p State' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;MG&quot;'>
              <calculation class='tableau' formula='&quot;MG&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.5g0p6rp0tvg32924ec5grivo9548'>
            <column caption='Substance Filter' datatype='boolean' name='[Calculation_7hg7r217bxoe]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] = &quot;All substances&quot; OR [substance_group] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='Value YoY' datatype='real' default-format='*+0.0%;-0.0%' name='[Calculation_q1qin1dpm14v]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sale_value_brl]) / LOOKUP(SUM([sale_value_brl]), -1) - 1'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Is Selected Year' datatype='boolean' name='[Calculation_qjv86hq7qojt]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[year] = [Parameters].[Parameter 1]' />
            </column>
            <column caption='State Filter' datatype='boolean' name='[Calculation_sze3koqg8rs3]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4] = &quot;All states&quot; OR [uf] = [Parameters].[Parameter 4]' />
            </column>
            <column caption='Value (R$ bn)' datatype='real' default-format='n#,##0.0' name='[Calculation_ujhkn4qbg4ab]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([sale_value_brl]) / 1000000000' />
            </column>
            <column-instance column='[Calculation_7hg7r217bxoe]' derivation='None' name='[none:Calculation_7hg7r217bxoe:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_qjv86hq7qojt]' derivation='None' name='[none:Calculation_qjv86hq7qojt:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_sze3koqg8rs3]' derivation='None' name='[none:Calculation_sze3koqg8rs3:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:ok]' pivot='key' type='ordinal' />
