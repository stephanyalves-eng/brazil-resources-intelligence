zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="4" /></zone-style></zone><zone h="2353" id="12" w="15000" x="22833" y="5882" mode='compact' param="[Parameters].[Parameter 3]" show-title='false' type-v2='paramctrl'><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="2" /></zone-style></zone><zone h="2017" id="13" w="3583" x="39333" y="6050" type-v2='text'><formatted-text><run bold="false" fontcolor="#B8C9C0" fontname="Consolas" fontsize="8">STATE</run></formatted-text><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="4" /></zone-style></zone><zone h="2353" id="14" w="9167" x="42917" y="5882" mode='compact' param="[Parameters].[Parameter 4]" show-title='false' type-v2='paramctrl'><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="2" /></zone-style></zone><zone h="2017" id="15" w="8250" x="53583" y="6050" type-v2='text'><formatted-text><run bold="false" fontcolor="#B8C9C0" fontname="Consolas" fontsize="8">CONCENTRATION</run></formatted-text><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="4" /></zone-style></zone><zone h="2353" id="16" w="17500" x="61833" y="5882" mode='compact' param="[Parameters].[Parameter 5]" show-title='false' type-v2='paramctrl'><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="2" /></zone-style></zone><zone h="1849" id="17" w="96000" x="2000" y="9916" type-v2='text'><formatted-text><run bold="false" fontcolor="#9A6412" fontname="Arial" fontsize="9">Geographic concentration ≠ business concentration: states (AMB value) and CNPJ roots (CFEM) answer different questions.</run></formatted-text><zone-style><format attr='margin' value="4" /></zone-style></zone><zone h="24370" id="18" w="47500" x="2000" y="12101" name="M1 HHI over time"><zone-style><format attr='background-color' value="#FFFFFF" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="4" /></zone-style></zone><zone h="24370" id="19" w="47500" x="50500" y="12101" name="M6 CFEM per R$ of sales"><zone-style><format attr='background-color' value="#FFFFFF" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="4" /></zone-style></zone><zone h="31092" id="20" w="47500" x="2000" y="37479" name="M2 Company Pareto"><zone-style><format attr='background-color' value="#FFFFFF" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="4" /></zone-style></zone><zone h="31092" id="21" w="47500" x="50500" y="37479" name="M4 Municipal concentration"><zone-style><format attr='background-color' value="#FFFFFF" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="4" /></zone-style></zone><zone h="27059" id="22" w="55583" x="2000" y="69580" name="M3 Concentration table"><zone-style><format attr='background-color' value="#FFFFFF" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="4" /></zone-style></zone><zone h="27059" id="23" w="39417" x="58583" y="69580" name="M5 Mix change"><zone-style><format attr='background-color' value="#FFFFFF" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="4" /></zone-style></zone><zone h="2353" id="24" w="96000" x="2000" y="97143" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Arial" fontsize="8">Source: ANM AMB &amp; CFEM, snapshot 2026-11-18 · nominal R$ · CFEM is royalty, not revenue · click any bar, state or row to filter (All resets) · Stephany Alves</run></formatted-text><zone-style><format attr='margin' value="4" /></zone-style></zone></zones><simple-id uuid="{FAEFB6CF-CC44-5376-963F-7CBF1F2B3BD9}" /></dashboard><dashboard name="4 · Data &amp; Methodology"><style><style-rule element='table'><format attr='background-color' value="#F5F4EC" /></style-rule></style><size maxheight="926" maxwidth="1200" minheight="926" minwidth="1200" sizing-mode='fixed' /><zones><zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0' /><zone h="11447" id="3" w="100000" x="0" y="0" type-v2='text'><formatted-text><run bold="false" fontcolor="#101714" fontname="Arial" fontsize="10"> </run></formatted-text><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="0" /></zone-style></zone><zone h="5832" id="4" w="46667" x="2000" y="1080" type-v2='text'><formatted-text><run bold="false" fontcolor="#B8C9C0" fontname="Consolas" fontsize="8">BRAZILIAN MINING · AMB + CFEM</run><run>Æ&#10;</run><run bold="false" fontcolor="#F5F4EC" fontname="Georgia" fontsize="22">Data &amp; Methodology</run></formatted-text><zone-style><format attr='background-color' value="#0B302B" /><format attr='margin' value="0" /></zone-style></zone><zone h="3024" id="5" w="8000" x="64500" y="1512" type-v2='dashboard-object'><button action='tabdoc:goto-sheet window-id=&quot;{A6F30EA8-822D-5506-8D6F-8F3CC437335C}&quot;' button-type='text'><button-visual-state><caption>Overview</caption><button-caption-font-style fontcolor="#F5F4EC" fontname='Arial' fontsize='8' /><format attr='background-color' value="#2F6B5B" /></button-visual-state></button></zone><zone h="3024" id="6" w="8000" x="73000" y="1512" type-v2='dashboard-object'><button action='tabdoc:goto-sheet window-id=&quot;{2212C406-46A6-57F7-ADBE-25E0A702AF8D}&quot;' button-type='text'><button-visual-state><caption>Regional</caption><button-caption-font-style fontcolor="#F5F4EC" fontname='Arial' fontsize='8' /><format attr='background-color' value="#2F6B5B" /></button-visual-state></button></zone><zone h="3024" id="7" w="8000" x="81500" y="1512" type-v2='dashboard-object'><button action='tabdoc:goto-sheet window-id=&quot;{591FD52F-5769-58E2-92AB-FC9227D34AEB}&quot;' button-type='text'><button-visual-state><caption>Market</caption><button-caption-font-style fontcolor="#F5F4EC" fontname='Arial' fontsize='8' /><format attr='background-color' value="#2F6B5B" /></button-visual-state></button></zone><zone h="3024" id="8" w="8000" x="90000" y="1512" type-v2='dashboard-object'><button action='tabdoc:goto-sheet window-id=&quot;{85779854-84D5-5AD1-86DE-86D6DECBAFE8}&quot;' button-type='text'><button-visual-state><caption>Method</caption><button-caption-font-style fontcolor="#0B302B" fontname='Arial' fontsize='8' /><format attr='background-color' value="#B8C9C0" /></button-visual-state></button></zone><zone h="35637" id="9" w="96000" x="2000" y="12743" name="D1 Sources"><zone-style><format attr='background-color' value="#FFFFFF" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="4" /></zone-style></zone><zone h="12959" id="10" w="47500" x="2000" y="50324" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">DEFINITIONS</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">K1 value of beneficiated sales (AMB, nominal R$) · K13 HHI = Σ share² × 10,000 (≥ 2,500 highly concentrated, 1,500–2,500 moderate) · K15 CFEM = royalty collected, not revenue.</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="12959" id="11" w="47500" x="50500" y="50324" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">PERIOD</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">AMB 2010–2025 (base years). CFEM 2004 – Jun 2026 (usable months; 2026 partial).</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="12959" id="12" w="47500" x="2000" y="64579" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">RULES</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">T8 substance collapse into groups · T13 duplicate CFEM export of Feb 2024 removed · completeness checks per year.</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="12959" id="13" w="47500" x="50500" y="64579" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">RESTRICTIONS</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">Nominal values (no deflation) · legal entity (CNPJ root) ≠ economic group · ES iron-ore caveat (pellet plants report sales of ore mined in MG) · no municipal map.</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="12959" id="14" w="47500" x="2000" y="78834" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">HOW TO USE</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">The YEAR, SUBSTANCE and STATE boxes filter every page. Clicking a bar, a state, a heatmap cell or a table row sets them and the choice follows you across pages; pick All in the box to reset. Views that need one substance (price × volume, HHI, company Pareto) show iron ore when All is selected.</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="12959" id="15" w="47500" x="50500" y="78834" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Consolas" fontsize="8">UPDATE</run><run>Æ&#10;</run><run bold="false" fontcolor="#454C48" fontname="Arial" fontsize="10">From mining-intelligence/: powershell -ExecutionPolicy Bypass -File src\run_pipeline.ps1 -Download, then refresh the extracts.</run></formatted-text><zone-style><format attr='background-color' value="#FBFAF6" /><format attr='border-color' value='#D6D8D2' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value="12" /></zone-style></zone><zone h="3024" id="16" w="96000" x="2000" y="96328" type-v2='text'><formatted-text><run bold="false" fontcolor="#5E6561" fontname="Arial" fontsize="8">Source: ANM AMB &amp; CFEM, snapshot 2026-11-18 · nominal R$ · CFEM is royalty, not revenue · click any bar, state or row to filter (All resets) · Stephany Alves</run></formatted-text><zone-style><format attr='margin' value="4" /></zone-style></zone></zones><simple-id uuid="{52183CA7-6EB1-5246-BCE9-598EF51BAF53}" /></dashboard></dashboards><windows source-height='31'><window class='worksheet' hidden='true' name="E1 KPI Value"><cards><edge name='left'><strip size='160'><