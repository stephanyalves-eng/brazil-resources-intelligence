es" THEN "Iron ore" ELSE [Parameters].[Parameter 3] END) THEN [sale_value_brl] END) / SUM(IF [year] = [Parameters].[Parameter 1] THEN [sale_value_brl] END)' /></column><column caption="KPI Top3 Share" datatype="real" default-format="p0.0%" name="[Calculation_qjbne9thnt15]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM(IF [year] = [Parameters].[Parameter 1] AND [rank_in_year] &lt;= 3 THEN [sale_value_brl] END) / SUM(IF [year] = [Parameters].[Parameter 1] THEN [sale_value_brl] END)" /></column><column caption="Focus Label" datatype="string" name="[Calculation_6g1g4sa0tnrh]" role="dimension" type="nominal"><calculation class='tableau' formula='UPPER((IF [Parameters].[Parameter 3] = "All substances" THEN "Iron ore" ELSE [Parameters].[Parameter 3] END))' /></column><column caption="Focus Rank" datatype="integer" default-format="n0;-0" name="[Calculation_40jx8ejmw3lg]" role="measure" type="quantitative"><calculation class='tableau' formula='MIN(IF [year] = [Parameters].[Parameter 1] AND [substance_group] = (IF [Parameters].[Parameter 3] = "All substances" THEN "Iron ore" ELSE [Parameters].[Parameter 3] END) THEN [rank_in_year] END)' /></column><column-instance column="[Calculation_ekbcdv3a61gn]" derivation="None" name="[none:Calculation_ekbcdv3a61gn:nk]" pivot='key' type="nominal" /><extract count='-1' enabled='true' units='records'><connection access_mode='readonly' class='hyper' dbname="C:/Users/steph/AppData/Local/Temp/claude/2969279fcb9c72d1/bcca2772-7244-432c-82bb-04d37b4c745f/scratchpad/hyper/amb_substance_year.hyper" default-settings='hyper' schema='Extract' sslmode='' tablename='Extract' username='tableau_internal_user'><relation name='Extract' table='[Extract].[Extract]' type='table' /></connection></extract><style><style-rule element='mark'><encoding attr='color' field="[none:Calculation_ekbcdv3a61gn:nk]" type='palette'><map to="#1e5246"><bucket>"Asbestos"</bucket></map><map to="#1e5246"><bucket>"Barite"</bucket></map><map to="#1e5