    <datasource caption='amb_substance_year' inline='true' name='federated.4j954jl9xcuesnuxjfpzqmh41lt3' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='amb_substance_year' name='textscan.a24odx0eg20cbyp3yjigazzlpn5g'>
            <connection class='textscan' directory='C:/Tableau/industrial-data-analytics/mining-intelligence/tableau/data' filename='amb_substance_year.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.a24odx0eg20cbyp3yjigazzlpn5g' name='amb_substance_year.csv' table='[amb_substance_year#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=',' text-qualifier='&quot;'>
            <column datatype='integer' name='year' ordinal='0' />
            <column datatype='string' name='substance_group' ordinal='1' />
            <column datatype='string' name='substance_class_en' ordinal='2' />
            <column datatype='real' name='sale_value_brl' ordinal='3' />
            <column datatype='real' name='production_qty' ordinal='4' />
            <column datatype='string' name='unit' ordinal='5' />
            <column datatype='integer' name='n_producing_ufs' ordinal='6' />
            <column datatype='real' name='share_of_national' ordinal='7' />
            <column datatype='integer' name='rank_in_year' ordinal='8' />
            <column datatype='real' name='cumulative_share' ordinal='9' />
            <column datatype='real' name='value_yoy' ordinal='10' />
            <column datatype='real' name='qty_yoy' ordinal='11' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='Value (R$ bn)' datatype='real' default-format='n#,##0.0' name='[Calculation_23hamdgdjdgc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([sale_value_brl]) / 1000000000' />
      </column>
      <column caption='Focus Rank' datatype='integer' default-format='n0;-0' name='[Calculation_40jx8ejmw3lg]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(IF [year] = [Parameters].[Parameter 1] AND [substance_group] = (IF [Parameters].[Parameter 3] = &quot;All substances&quot; THEN &quot;Iron ore&quot; ELSE [Parameters].[Parameter 3] END) THEN [rank_in_year] END)' />
      </column>
      <column caption='Focus Label' datatype='string' name='[Calculation_6g1g4sa0tnrh]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER((IF [Parameters].[Parameter 3] = &quot;All substances&quot; THEN &quot;Iron ore&quot; ELSE [Parameters].[Parameter 3] END))' />
      </column>
      <column caption='Is Focus Substance' datatype='boolean' name='[Calculation_9e5ehjq9avyn]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[substance_group] = (IF [Parameters].[Parameter 3] = &quot;All substances&quot; THEN &quot;Iron ore&quot; ELSE [Parameters].[Parameter 3] END)' />
      </column>
      <column caption='Is Selected Year' datatype='boolean' name='[Calculation_bvwumh4gzlpa]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[year] = [Parameters].[Parameter 1]' />
      </column>
      <column caption='Highlight Substance' datatype='string' name='[Calculation_ekbcdv3a61gn]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [substance_group] = (IF [Parameters].[Parameter 3] = &quot;All substances&quot; THEN &quot;Iron ore&quot; ELSE [Parameters].[Parameter 3] END) THEN [substance_group] ELSE &quot;Other substances&quot; END' />
      </column>
      <column caption='KPI Focus Share' datatype='real' default-format='p0.0%' name='[Calculation_h8y81buz7uoc]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [year] = [Parameters].[Parameter 1] AND [substance_group] = (IF [Parameters].[Parameter 3] = &quot;All substances&quot; THEN &quot;Iron ore&quot; ELSE [Parameters].[Parameter 3] END) THEN [sale_value_brl] END) / SUM(IF [year] = [Parameters].[Parameter 1] THEN [sale_value_brl] END)' />
      </column>
      <column caption='Substance Filter' datatype='boolean' name='[Calculation_ph2znl73sv7p]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3] = &quot;All substances&quot; OR [substance_group] = [Parameters].[Parameter 3]' />
      </column>
      <column caption='KPI Top3 Share' datatype='real' default-format='p0.0%' name='[Calculation_qjbne9thnt15]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [year] = [Parameters].[Parameter 1] AND [rank_in_year] &lt;= 3 THEN [sale_value_brl] END) / SUM(IF [year] = [Parameters].[Parameter 1] THEN [sale_value_brl] END)' />
      </column>
      <column caption='Dados migrados' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column datatype='real' default-format='p0.0%' name='[cumulative_share]' role='measure' type='quantitative' />
