lass='tableau' formula='[Parameters].[Parameter 3] = "All substances" OR [substance_group] = [Parameters].[Parameter 3]' /></column><column caption="Is Focus Substance" datatype="boolean" name="[Calculation_h7n0s1ryrjmc]" role="dimension" type="nominal"><calculation class='tableau' formula='[substance_group] = (IF [Parameters].[Parameter 3] = "All substances" THEN "Iron ore" ELSE [Parameters].[Parameter 3] END)' /></column><column caption="State Filter" datatype="boolean" name="[Calculation_sze3koqg8rs3]" role="dimension" type="nominal"><calculation class='tableau' formula='[Parameters].[Parameter 4] = "All states" OR [uf] = [Parameters].[Parameter 4]' /></column><column caption="Is Selected Year" datatype="boolean" name="[Calculation_qjv86hq7qojt]" role="dimension" type="nominal"><calculation class='tableau' formula="[year] = [Parameters].[Parameter 1]" /></column><column caption="Highlight Substance" datatype="string" name="[Calculation_t8yvlgm3228m]" role="dimension" type="nominal"><calculation class='tableau' formula='IF [substance_group] = (IF [Parameters].[Parameter 3] = "All substances" THEN "Iron ore" ELSE [Parameters].[Parameter 3] END) THEN [substance_group] ELSE "Other substances" END' /></column><column caption="Value (R$ bn)" datatype="real" default-format="n#,##0.0" name="[Calculation_ujhkn4qbg4ab]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([sale_value_brl]) / 1000000000" /></column><column caption="Selection Label" datatype="string" name="[Calculation_hy4imhkirmbl]" role="dimension" type="nominal"><calculation class='tableau' formula='(IF [Parameters].[Parameter 3] = "All substances" THEN "ALL SUBSTANCES" ELSE UPPER([Parameters].[Parameter 3]) END) + " · " + (IF [Parameters].[Parameter 4] = "All states" THEN "BRAZIL" ELSE [Parameters].[Parameter 4] END)' /></column><column caption="State Name" datatype="string" name="[Calculation_3pcgn0akbklj]" role="dimension" type="nominal"><calculation class='tableau' formula='CASE [uf] WHEN "AC" THEN "Acre" WHEN "AL" THEN "Alagoas" WHEN "AM" THEN "Amazonas" WHEN "AP" THEN "Amapá" WHEN "BA" THEN "Bahia" WHEN "CE" THEN "Ceará" WHEN "DF" THEN "Distrito Federal" WHEN "ES" THEN "Espírito Santo" WHEN "GO" THEN "Goiás" WHEN "MA" THEN "Maranhão" WHEN "MG" THEN "Minas Gerais" WHEN "MS" THEN "Mato Grosso do Sul" WHEN "MT" THEN "Mato Grosso" WHEN "PA" THEN "Pará" WHEN "PB" THEN "Paraíba" WHEN "PE" THEN "Pernambuco" WHEN "PI" THEN "Piauí" WHEN "PR" THEN "Paraná" WHEN "RJ" THEN "Rio de Janeiro" WHEN "RN" THEN "Rio Grande do Norte" WHEN "RO" THEN "Rondônia" WHEN "RR" THEN "Roraima" WHEN "RS" THEN "Rio Grande do Sul" WHEN "SC" THEN "Santa Catarina" WHEN "SE" THEN "Sergipe" WHEN "SP" THEN "São Paulo" WHEN "TO" THEN "Tocantins" ELSE [uf] END' /></column><column caption="KPI Value (R$ bn)" datatype="real" default-format="n#,##0.0" name="[Calculation_5bbpidoeno9o]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM(IF [year] = [Parameters].[Parameter 1] THEN [sale_value_brl] END) / 1000000000" /></column><column caption="KPI Value Prev (R$ bn)" datatype="real" default-format="n#,##0.0" name="[Calculation_46bs9yx3lbcm]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM(IF [year] = [Parameters].[Parameter 1] - 1 THEN [sale_value_brl] END) / 1000000000" /></column><column caption="KPI Value YoY" datatype="real" default-format="*+0.0%;-0.0%" name="[Calculation_f2o9zfkfz3mj]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [Calculation_46bs9yx3lbcm] &gt; 0 THEN [Calculation_5bbpidoeno9o] / [Calculation_46bs9yx3lbcm] - 1 END" /></column><column caption="KPI CAGR since 2010" datatype="real" default-format="*+0.0%;-0.0%" name="[Calculation_fjg29sv5ux8o]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [Parameters].[Parameter 1] &gt; 2010 THEN POWER([Calculation_5bbpidoeno9o] / (SUM(IF [year] = 2010 THEN [sale_value_brl] END) / 1000000000), 1 / ([Parameters].[Parameter 1] - 2010)) - 1 END" /></column><column caption="YoY Arrow" datatype="string" name="[Calculation_v7clhn5ntdp2]" role="measure" type="nominal"><calculation class='tableau' formula='IF [Calculation_f2o9zfkfz3mj] &gt;= 0 THEN "▲ " ELSE "▼ " END' /></column><column caption="Value YoY" datatype="real" default-format="*+0.0%;-0.0%" name="[Calculation_q1qin1dpm14v]" role="measure" type="quantitative"><calculation class='tableau' formula="SUM([sale_value_brl]) / LOOKUP(SUM([sale_value_brl]), -1) - 1" /></column><column caption="State Share" datatype="real" default-format="p0.0%" name="[Calculation_o78w4758rpef]" role="measure" type="quantitative"><calculation class='tableau' formula='SUM([sale_value_brl]) / MIN({FIXED [year] : SUM(IF [Parameters].[Parameter 3] = "All substances" OR [substance_group] = [Parameters].[Parameter 3] THEN [sale_value_brl] END)})' /></column><column caption="Substance Share" datatype="real" default-format="p0.0%" name="[Calculation_8e50jnkorow5]" role="measure" type="quantitative"><calculation class='tableau' formula='SUM([sale_value_brl]) / MIN({FIXED [year] : SUM(IF [Parameters].[Parameter 4] = "All states" OR [uf] = [Parameters].[Parameter 4] THEN [sale_value_brl] END)})' /></column><column caption="State Label" datatype="string" name="[Calculation_u11texuei4ib]" role="measure" type="nominal"><calculation class='tableau' formula='ATTR([Calculation_3pcgn0akbklj]) + " · " + STR(ROUND([Calculation_o78w4758rpef] * 100, 1)) + "%"' /></column><column caption="State Highlight" datatype="string" name="[Calculation_el4judxn9a54]" role="dimension" type="nominal"><calculation class='tableau' formula='IF [Parameters].[Parameter 4] = "All states" THEN "All" ELSEIF [uf] = [Parameters].[Parameter 4] THEN "Selected" ELSE "Other" END' /></column><column caption="Quantity (selected group)" datatype="real" default-format="n#,##0" name="[Calculation_4d2tjlpkzh1e]" role="measure" type="quantitative"><calculation class='tableau' formula="IF [substance_group] = [Parameters].[Parameter 3] THEN [production_qty] END" /></column><column caption="DQ Caveat" datatype="string" name="[Calculation_j5bvcm0pftbi]" role="dimension" type="nominal"><calculation class='tableau' formula='IF [dq_flag_intermittent_series] THEN "Intermittent reporting (see methodology)" END' /></column><column caption="Sub Value Sel" datatype="real" default-format="n#,##0" name="[Calculation_eppy3fvqevpz]" role="measure" type="quantitative"><calculation class='tableau' formula='{FIXED [substance_group] : SUM(IF [year] = [Parameters].[Parameter 1] AND ([Parameters].[Parameter 4] = "All states" OR [uf] = [Parameters].[Parameter 4]) THEN [sale_value_brl] END)}' /></column><column caption="Focus Value Sel" datatype="real" default-format="n#,##0" name="[Calculation_76y6wsofyhdb]" role="measure" type="quantitative"><calculation class='tableau' formula='{FIXED : SUM(IF [year] = [Parameters].[Parameter 1] AND ([Parameters].[Parameter 4] = "All states" OR [uf] = [Parameters].[Parameter 4]) AND [substance_group] = (IF [Parameters].[Parameter 3] = "All substances" THEN "Iron ore" ELSE [Parameters].[Parameter 3] END) THEN [sale_value_brl] END)}' /></column><column caption="KPI Focus Share" datatype="real" default-format="p0.0%" name="[Calculation_3vu8yo2kk2qo]" role="measure" type="quantitative"><calculation class='tableau' formula="MIN([Calculation_76y6wsofyhdb]) / SUM(IF [year] = [Parameters].[Parameter 1] THEN [sale_value_brl] END)" /></column><column caption="Focus Rank" datatype="integer" default-format="n0;-0" name="[Calculation_yx5ua1mb7lry]" role="measure" type="quantitative"><calculation class='tableau' formula="COUNTD(IF [Calculation_eppy3fvqevpz] &gt; [Calculation_76y6wsofyhdb] THEN [substance_group] END) + 1" /></column><column caption="Focus Label" datatype="string" name="[Calculation_pn0nq3g7bxu3]" role="dimension" type="nominal"><calculation class='tableau' formula='UPPER((IF [Parameters].[Parameter 3] = "All substances" THEN "Iron ore" ELSE [Paramete