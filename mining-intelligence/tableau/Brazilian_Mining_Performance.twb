    <worksheet name='E1 KPI Value'>
      <table>
        <view>
          <datasources>
            <datasource caption='amb_uf_substance_year' name='federated.5g0p6rp0tvg32924ec5grivo9548' />
            <datasource caption='Parâmetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p Year' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
            <column caption='p Substance' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All substances&quot;'>
              <calculation class='tableau' formula='&quot;All substances&quot;' />
            </column>
            <column caption='p State' datatype='string' name='[Parameter 4]' param-domain-type='list' role='measure' type='nominal' value='&quot;MG&quot;'>
              <calculation class='tableau' formula='&quot;MG&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.5g0p6rp0tvg32924ec5grivo9548'>
            <column caption='KPI Value Prev (R$ bn)' datatype='real' default-format='n#,##0.0' name='[Calculation_46bs9yx3lbcm]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [year] = [Parameters].[Parameter 1] - 1 THEN [sale_value_brl] END) / 1000000000' />
            </column>
            <column caption='KPI Value (R$ bn)' datatype='real' default-format='n#,##0.0' name='[Calculation_5bbpidoeno9o]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [year] = [Parameters].[Parameter 1] THEN [sale_value_brl] END) / 1000000000' />
            </column>
            <column caption='Substance Filter' datatype='boolean' name='[Calculation_7hg7r217bxoe]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 3] = &quot;All substances&quot; OR [substance_group] = [Parameters].[Parameter 3]' />
            </column>
            <column caption='KPI Value YoY' datatype='real' default-format='*+0.0%;-0.0%' name='[Calculation_f2o9zfkfz3mj]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_46bs9yx3lbcm] &gt; 0 THEN [Calculation_5bbpidoeno9o] / [Calculation_46bs9yx3lbcm] - 1 END' />
            </column>
            <column caption='Selection Label' datatype='string' name='[Calculation_hy4imhkirmbl]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='(IF [Parameters].[Parameter 3] = &quot;All substances&quot; THEN &quot;ALL SUBSTANCES&quot; ELSE UPPER([Parameters].[Parameter 3]) END) + &quot; · &quot; + (IF [Parameters].[Parameter 4] = &quot;All states&quot; THEN &quot;BRAZIL&quot; ELSE [Parameters].[Parameter 4] END)' />
            </column>
            <column caption='State Filter' datatype='boolean' name='[Calculation_sze3koqg8rs3]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 4] = &quot;All states&quot; OR [uf] = [Parameters].[Parameter 4]' />
            </column>
            <column caption='YoY Arrow' datatype='string' name='[Calculation_v7clhn5ntdp2]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_f2o9zfkfz3mj] &gt;= 0 THEN &quot;▲ &quot; ELSE &quot;▼ &quot; END' />
            </column>
            <column-instance column='[Calculation_7hg7r217bxoe]' derivation='None' name='[none:Calculation_7hg7r217bxoe:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_hy4imhkirmbl]' derivation='None' name='[none:Calculation_hy4imhkirmbl:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_sze3koqg8rs3]' derivation='None' name='[none:Calculation_sze3koqg8rs3:nk]' pivot='key' type='nominal' />
            <column datatype='real' default-format='n#,##0' name='[sale_value_brl]' role='measure' type='quantitative' />
            <column datatype='string' name='[substance_group]' role='dimension' type='nominal' />
            <column datatype='string' name='[uf]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[Calculation_5bbpidoeno9o]' derivation='User' name='[usr:Calculation_5bbpidoeno9o:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_f2o9zfkfz3mj]' derivation='User' name='[usr:Calculation_f2o9zfkfz3mj:qk]' pivot='key' type='quantitative' />
