          <datasources>
            <datasource caption='amb_substance_year' name='federated.4j954jl9xcuesnuxjfpzqmh41lt3' />
            <datasource caption='Parâmetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='p Year' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2025'>
              <calculation class='tableau' formula='2025' />
            </column>
            <column caption='p Substance' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All substances&quot;'>
              <calculation class='tableau' formula='&quot;All substances&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.4j954jl9xcuesnuxjfpzqmh41lt3'>
            <column caption='Focus Rank' datatype='integer' default-format='n0;-0' name='[Calculation_40jx8ejmw3lg]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(IF [year] = [Parameters].[Parameter 1] AND [substance_group] = (IF [Parameters].[Parameter 3] = &quot;All substances&quot; THEN &quot;Iron ore&quot; ELSE [Parameters].[Parameter 3] END) THEN [rank_in_year] END)' />
            </column>
            <column caption='Focus Label' datatype='string' name='[Calculation_6g1g4sa0tnrh]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='UPPER((IF [Parameters].[Parameter 3] = &quot;All substances&quot; THEN &quot;Iron ore&quot; ELSE [Parameters].[Parameter 3] END))' />
            </column>
            <column caption='KPI Focus Share' datatype='real' default-format='p0.0%' name='[Calculation_h8y81buz7uoc]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [year] = [Parameters].[Parameter 1] AND [substance_group] = (IF [Parameters].[Parameter 3] = &quot;All substances&quot; THEN &quot;Iron ore&quot; ELSE [Parameters].[Parameter 3] END) THEN [sale_value_brl] END) / SUM(IF [year] = [Parameters].[Parameter 1] THEN [sale_value_brl] END)' />
            </column>
            <column caption='KPI Top3 Share' datatype='real' default-format='p0.0%' name='[Calculation_qjbne9thnt15]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [year] = [Parameters].[Parameter 1] AND [rank_in_year] &lt;= 3 THEN [sale_value_brl] END) / SUM(IF [year] = [Parameters].[Parameter 1] THEN [sale_value_brl] END)' />
            </column>
            <column-instance column='[Calculation_6g1g4sa0tnrh]' derivation='None' name='[none:Calculation_6g1g4sa0tnrh:nk]' pivot='key' type='nominal' />
            <column datatype='integer' name='[rank_in_year]' role='measure' type='quantitative' />
            <column datatype='real' default-format='n#,##0' name='[sale_value_brl]' role='measure' type='quantitative' />
            <column datatype='string' name='[substance_group]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_40jx8ejmw3lg]' derivation='User' name='[usr:Calculation_40jx8ejmw3lg:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_h8y81buz7uoc]' derivation='User' name='[usr:Calculation_h8y81buz7uoc:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_qjbne9thnt15]' derivation='User' name='[usr:Calculation_qjbne9thnt15:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' default-format='n0;-0' name='[year]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <aggregation value='true' />
