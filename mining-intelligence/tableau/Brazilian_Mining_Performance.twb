      </column>
      <column caption='Is Focus Substance' datatype='boolean' name='[Calculation_2rwu6prwcyzd]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[substance_group] = (IF [Parameters].[Parameter 3] = &quot;All substances&quot; THEN &quot;Iron ore&quot; ELSE [Parameters].[Parameter 3] END)' />
      </column>
      <column caption='AMB Years' datatype='boolean' name='[Calculation_cha42p5f9aw3]' role='dimension' type='nominal'>
