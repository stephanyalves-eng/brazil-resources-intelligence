# Environment
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Raw and intermediate data are reproducible from the official sources (see each project's
# data/raw/MANIFEST.csv for URL, size and SHA-256). They are not versioned.
*/data/raw/*
!*/data/raw/.gitkeep
!*/data/raw/MANIFEST.csv
*/data/interim/*
!*/data/interim/.gitkeep

# Processed outputs are regenerated by the pipelines (slim Tableau extracts are versioned under <project>/tableau/)
*/data/processed/*
!*/data/processed/.gitkeep

# Local databases
*.duckdb
*.duckdb.wal

# OS / editor
desktop.ini
Thumbs.db
.vscode/

# Tableau lock files and generator smoke tests
~*.twbr
shared/tableau_twb/smoke_test*.twb
